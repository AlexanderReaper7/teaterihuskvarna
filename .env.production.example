# The production host's .env starts as a copy of this file:
#
#   cp .env.production.example .env
#
# It holds every variable compose.yaml reads and nothing that loads
# compose.dev.yaml or compose.share.yaml, so `docker compose up` runs
# compose.yaml alone. Never set COMPOSE_FILE or SPRING_PROFILES_ACTIVE on the
# production host: the dev profile logs anyone in as any administrator at
# /dev/login. The application refuses to start under that profile once
# SITE_URL is set. Local development uses .env.example instead.
#
# .env is git-ignored and holds real credentials. A value left empty below
# stops the stack: compose refuses an empty POSTGRES_PASSWORD, and the
# application refuses to start on the others, unless a comment says the value
# is optional. `docker compose config --quiet` checks the first.
#
# BUILD_GIT_DIR, BUILD_GIT_WORKTREE and APP_IMAGE are the three variables
# compose.yaml reads that are not here: its defaults build the image from a
# plain clone of the repository.

# The site's address. SITE_HOST is the host name alone, such as
# teaterihuskvarna.se. Traefik routes requests for it and gets its Let's
# Encrypt certificate, so the name's DNS record must point at this host before
# the first start. Nothing refuses an empty SITE_HOST: compose renders the
# route as Host(``), which matches no request.
SITE_HOST=
# The same host with its scheme, such as https://teaterihuskvarna.se. Login
# links, the sitemap and canonical addresses are built from it, and its host is
# the passkey relying party.
SITE_URL=

# The database. The password is generated on the host, for example with
# `openssl rand -hex 32`. PostgreSQL reads all three only when the volume is
# created, so changing one later does not change the database.
POSTGRES_DB=teaterihuskvarna
POSTGRES_USER=teaterihuskvarna
POSTGRES_PASSWORD=

# The first administrator account, created at startup only when no
# administrator exists. The address gets the first login link, so it must be an
# inbox a board member reads. Ignored once an administrator exists.
FIRST_ADMINISTRATOR_EMAIL=
FIRST_ADMINISTRATOR_NAME=

# MAIL_FROM is the sender on every login and confirmation mail, an address
# Brevo has verified as a sender. BANKGIRO is the number a new member is told
# to pay the fee to. Question C10 in docs/open-questions.md asks the
# association whether 817-5531 still is that number.
MAIL_FROM=
BANKGIRO=

# Login and confirmation mail goes through Brevo's SMTP relay:
# docs/decisions/0005. The address and port are the ones Brevo documents. The
# login and the key are on Brevo's "SMTP & API" page, under SMTP. The key is an
# SMTP key, which is not the API key further down. Nothing refuses empty
# values here: the application starts, and every mail fails when it is sent.
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=

# Brevo's API, for contacts and mailings: docs/decisions/0026. BREVO_API_KEY
# is an API key from the same "SMTP & API" page. BREVO_LIST_ID is the id of
# the list every member with an account is kept on, and BREVO_TEST_LIST_ID the
# id of the list an administrator's address joins before a test send. Both
# lists are made once by hand in Brevo. BREVO_SENDER_NAME and
# BREVO_SENDER_EMAIL are who a mailing comes from, and the address must be a
# sender verified in Brevo. An account that accepts API calls only from
# authorised IP addresses, as the development account does, needs this host's
# address added.
BREVO_API=http
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_TEST_LIST_ID=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# Sanity, for the public content: docs/decisions/0021. The project id and the
# dataset name are on the project's page at https://www.sanity.io/manage, and
# the dataset is the one the deployed Studio writes to.
CONTENT_SOURCE=sanity
SANITY_PROJECT_ID=
SANITY_DATASET_NAME=
# Optional, and each one that is empty turns something off. SANITY_API_KEY is
# a token with the Viewer role from the project's API settings: without it a
# private dataset shows nothing and the Studio's preview does not work.
# SANITY_WEBHOOK_SECRET is the secret typed into the project's webhook to
# https://<SITE_HOST>/api/sanity/webhook: without it a published change takes
# up to 45 seconds to show. SANITY_STUDIO_URL is the deployed Studio's origin,
# such as https://teaterihuskvarna.sanity.studio: without it the
# administration pages say that the editor is not connected. studio/README.md
# describes all three.
SANITY_API_KEY=
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_URL=
