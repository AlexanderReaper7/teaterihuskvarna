<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>se.teaterihuskvarna</groupId>
  <artifactId>teaterihuskvarna</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>teaterihuskvarna</name>
  <description>Website and member register for Teater i Huskvarna</description>

  <properties>
    <java.version>25</java.version>
    <java.sourceDirectory>${project.basedir}/src/main/java</java.sourceDirectory>
    <!-- Latest stable releases checked against Maven Central on 2026-10-01. -->
    <jspecify.version>1.0.1</jspecify.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.2</nullaway.version>
    <!-- Versions newer than the ones Spring Boot 4.1.1 manages. Checked against
         Maven Central on 2026-09-22; see docs/decisions/0010 and 0011. -->
    <jte.version>3.2.4</jte.version>
    <flyway.version>13.7.0</flyway.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Boot 4.1.1 manages 9.2.0. 10.0.1 is Maven Central's latest, checked on
         2026-09-23. -->
    <git-commit-id-maven-plugin.version>10.0.1</git-commit-id-maven-plugin.version>
    <!-- The three static analysis gates: docs/decisions/0013. Checked against
         Maven Central on 2026-09-22; each is the latest release. -->
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.version>14.1.0</checkstyle.version>
    <spotbugs.plugin.version>4.10.4.1</spotbugs.plugin.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.27.0</pmd.version>
    <!-- Tie PMD's analysis target to the compiler target, so a Java upgrade
         cannot leave PMD reading class files it does not understand. -->
    <pmd.target.jdk>${java.version}</pmd.target.jdk>
    <archunit.version>1.5.0</archunit.version>
    <!-- spring-security-webauthn 7.1.1 asks for 0.31.9.RELEASE, and Boot does
         not manage it. 0.31.10.RELEASE is Maven Central's latest, checked on
         2026-09-23. The test emulator is pinned to the same release. -->
    <webauthn4j.version>0.31.10.RELEASE</webauthn4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Login by one-time link, sessions, CSRF and the access rules. The
         links themselves are Spring Security's one-time-token login, with a
         token store that keeps hashes: docs/decisions/0015. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Login with a passkey, beside the link. Spring's filters with this
         project's paths and lookups: docs/decisions/0016. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-webauthn</artifactId>
    </dependency>
    <dependency>
      <groupId>com.webauthn4j</groupId>
      <artifactId>webauthn4j-core</artifactId>
      <version>${webauthn4j.version}</version>
    </dependency>
    <!-- Sessions in PostgreSQL, so a 30-day member login survives a deploy.
         Flyway owns the tables, from V3: docs/decisions/0015. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>
    <!-- Login links and confirmation links over SMTP: Mailpit locally, Brevo
         in production, per docs/decisions/0005. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Validation on the service methods, so both adapters get the same
         checks: docs/decisions/0014. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>gg.jte</groupId>
      <artifactId>jte-spring-boot-starter-4</artifactId>
      <version>${jte.version}</version>
    </dependency>
    <!-- Boot 4 moved Flyway auto-configuration out of spring-boot-autoconfigure
         into its own module. With only flyway-core on the classpath, migrations
         silently do not run: MemberRegisterSchemaIT is the guard against that. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Reads the compiled classes to check the adapter rules in
         docs/decisions/0014, including the one nothing else can check: that
         every capability a JTE page uses also has a REST endpoint. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 splits the test slices per technology: @WebMvcTest is here, not in
         spring-boot-test-autoconfigure the way Boot 3 had it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A software authenticator, so the passkey tests run real registration
         and login ceremonies against the server. -->
    <dependency>
      <groupId>com.webauthn4j</groupId>
      <artifactId>webauthn4j-test</artifactId>
      <version>${webauthn4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${java.sourceDirectory}</sourceDirectory>
    <plugins>
      <!-- Nullability is checked by javac, including test compilation. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <fork>true</fork>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
            <!-- Keep plugin options in one argument without embedded newlines. -->
            <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -Xep:RequireExplicitNullMarking:ERROR -Xep:JSpecifyUnrecognizedAnnotationLocation:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:ExternalInitAnnotations=jakarta.persistence.Entity -XepOpt:NullAway:HandleTestAssertionLibraries=true</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- build-info writes META-INF/build-info.properties, and the git plugin
           writes git.properties, so the development index can show which build
           and which commit is running. Boot's parent configures the git plugin;
           it needs .git, which the Dockerfile copies into the build stage. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <!-- The default is project.build.outputTimestamp, which Maven 4
                   fixes at 1980-02-01 for reproducible jars, so every build
                   would claim that date. This one file then differs between
                   two builds of the same commit; the jar's entry timestamps
                   stay fixed. -->
              <time>${maven.build.timestamp}</time>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- git.dirty is true when the worktree differed from the commit, so a
           build is never shown as that commit when it was not. The default
           provider, JGit, ignores untracked files, so a new source file not
           yet added would still read as clean. The Dockerfile therefore runs
           this plugin on git itself, whose `git status -s` lists them.
           Only these properties are written, because the rest put the
           committer's email address and full commit message into the jar. -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <configuration>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
            <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <!-- Compiles every .jte template to a Java class. This is the whole reason
           0004 chose JTE: a renamed field fails the build rather than a page. -->
      <plugin>
        <groupId>gg.jte</groupId>
        <artifactId>jte-maven-plugin</artifactId>
        <version>${jte.version}</version>
        <configuration>
          <sourceDirectory>${project.basedir}/src/main/jte</sourceDirectory>
          <targetDirectory>${project.build.outputDirectory}</targetDirectory>
          <contentType>Html</contentType>
          <binaryStaticContent>true</binaryStaticContent>
        </configuration>
        <executions>
          <execution>
            <id>precompile</id>
            <phase>process-classes</phase>
            <goals><goal>precompile</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Copies the hooks in .githooks into .git/hooks, so any clone that
           builds gets them with no setup step. core.hooksPath would need a git
           command run once per clone, which is the setup step this avoids.
           Skipped when .git is not a directory: a git worktree, which uses
           the main checkout's hooks, or a copy without history.

           The Dockerfile build copies into the image's own .git, so a clone
           that only ever builds through docker compose never gets the hook.
           `verify`, the VS Code default build task, is what installs it.

           Overwrites any hook of your own with the same name. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>install-git-hooks</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target xmlns:if="ant:if">
                <condition property="git.hooks.install">
                  <available file="${project.basedir}/.git" type="dir"/>
                </condition>
                <copy if:set="git.hooks.install" overwrite="true"
                      todir="${project.basedir}/.git/hooks">
                  <fileset dir="${project.basedir}/.githooks"/>
                </copy>
                <chmod if:set="git.hooks.install" perm="755">
                  <fileset dir="${project.basedir}/.git/hooks"
                           includes="post-checkout"/>
                </chmod>
              </target>
            </configuration>
          </execution>
          <!-- Copies .env.example to .env when there is none, like the
               post-checkout hook, so the first build of a fresh clone creates
               it before any `docker compose up`. The condition is needed
               because ant's copy replaces a target older than its source. -->
          <execution>
            <id>create-env</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target xmlns:if="ant:if">
                <condition property="env.missing">
                  <not><available file="${project.basedir}/.env"/></not>
                </condition>
                <copy if:set="env.missing" file="${project.basedir}/.env.example"
                      tofile="${project.basedir}/.env"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
           Three static analysis gates, all failing the build. Ported from
           C:\Projects\Lexicon-flight-reservation; reasoning and the
           divergences are in docs/decisions/0013.

           checkstyle runs at `validate`, so a style violation stops the build
           before anything compiles, which means `docker build` runs it too.
           spotbugs and pmd need bytecode and run in their default phase,
           `verify`, which is after the tests and therefore outside the image
           build. `./mvnw verify` is the command that runs all three.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <!-- checkstyle.xml resolves suppressions.xml through ${config_loc},
               which the plugin does not define on its own. Without this the
               goal dies with "Property ${config_loc} has not been set" rather
               than quietly skipping the suppressions. -->
          <propertyExpansion>config_loc=${project.basedir}</propertyExpansion>
          <violationSeverity>error</violationSeverity>
          <!-- `failOnViolation` and not `failsOnError`, which the plugin's own
               help says fails "immediately ... before checking the log for
               logViolationsToConsole". With `failsOnError` the build reported
               "There is 1 error" and never printed the file or the line.
               Measured 2026-09-22; the VS Code task parses these lines into the
               Problems panel. -->
          <failOnViolation>true</failOnViolation>
          <logViolationsToConsole>true</logViolationsToConsole>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.plugin.version}</version>
        <configuration>
          <failOnViolation>true</failOnViolation>
          <printFailingErrors>true</printFailingErrors>
          <targetJdk>${pmd.target.jdk}</targetJdk>
        </configuration>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
        <!-- PMD is pinned ahead of the version the plugin bundles. A bundled PMD
             that cannot read this project's class files still parses sources, so
             syntactic rules fire and the build looks healthy while every
             type-aware rule silently checks nothing. docs/decisions/0013. -->
        <dependencies>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-core</artifactId>
            <version>${pmd.version}</version>
          </dependency>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-java</artifactId>
            <version>${pmd.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- Integration tests need a docker daemon, which a docker build stage does
           not have. They run through compose or CI instead: docs/decisions/0011. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- The probes use the normal compiler settings, with isolated sources and output. -->
    <profile>
      <id>nullability-probe</id>
      <properties>
        <java.sourceDirectory>${project.build.directory}/src</java.sourceDirectory>
      </properties>
      <build>
        <directory>${project.basedir}/target/nullability-probe</directory>
      </build>
    </profile>
  </profiles>
</project>
