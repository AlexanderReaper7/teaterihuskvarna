# Copy to .env and fill in. .env is git-ignored and holds real credentials.

# Sanity, per docs/decisions/0006
SANITY_PROJECT_ID=
SANITY_DATASET_NAME=
SANITY_ORG_ID=
SANITY_API_KEY=

# Brevo, per docs/decisions/0005
BREVO_API_KEY=

# Transactional mail. Mailpit locally, Brevo in production.
SMTP_ADDRESS=
SMTP_PORT=
SMTP_LOGIN=
SMTP_KEY=

# Database and proxy. The defaults in compose.yaml cover local development, so
# these only need setting in production.
POSTGRES_DB=teaterihuskvarna
POSTGRES_USER=teaterihuskvarna
POSTGRES_PASSWORD=
SITE_ADDRESS=:80
