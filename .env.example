# Copied to .env when a checkout has none, by the Maven build, the VS Code
# compose tasks and the post-checkout hook, and works locally as it is. .env is
# git-ignored and holds real credentials.

# Sanity, per docs/decisions/0006 and 0021. SANITY_API_KEY is a read token,
# needed for a private dataset and for the Studio's preview.
# SANITY_WEBHOOK_SECRET is the secret on the project's webhook to
# /api/sanity/webhook. SANITY_STUDIO_URL is the Studio's origin, such as
# https://teaterihuskvarna.sanity.studio, which may show the site in a frame.
# CONTENT_SOURCE=sanity makes the dev profile read the dataset instead of the
# invented content in src/main/resources/content/fixture.json.
SANITY_PROJECT_ID=
SANITY_DATASET_NAME=
SANITY_ORG_ID=
SANITY_API_KEY=
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_URL=
CONTENT_SOURCE=

# Brevo, for mailings, per docs/decisions/0005 and 0023. BREVO_FOLDER_ID is
# the contact folder each mailing's list goes in. BREVO_TEST_LIST_ID is a list
# an administrator's address joins before a test send, which Brevo requires.
# BREVO_SENDER_EMAIL must be a sender verified in Brevo. BREVO_API=fake keeps
# the dev profile's mailings in memory, which is its default.
BREVO_API=
BREVO_API_KEY=
BREVO_FOLDER_ID=
BREVO_TEST_LIST_ID=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# Local development: compose.dev.yaml adds the dev profile (invented settings
# and DevSeed), Mailpit, and plain HTTP on PROXY_HTTP_PORT. Never in production.
# Remove these four lines there. The separator is set because Compose on
# Windows otherwise splits COMPOSE_FILE on ";". The password is here, and not a
# default in compose.yaml, so a production .env without these lines still
# refuses to start until someone sets a real one.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_PATH_SEPARATOR=:
PROXY_HTTP_PORT=8000
POSTGRES_PASSWORD=local-development-only

# Sharing the dev stack through a Tailscale Funnel: README.md. Add
# compose.share.yaml to COMPOSE_FILE and set both. SHARE_URL is the public
# address, such as https://nixos-desktop.java-tint.ts.net:8443. SHARE_BASIC_AUTH
# is an htpasswd line from `htpasswd -nbB <user> <password>`, in single quotes
# so the $ in the hash stays literal.
SHARE_URL=
SHARE_BASIC_AUTH=

# Transactional mail through Brevo's SMTP relay in production. The dev profile
# ignores these and always uses Mailpit, so the invented seed addresses never
# reach a real relay: src/main/resources/application-dev.yaml.
SMTP_ADDRESS=mail
SMTP_PORT=1025
SMTP_LOGIN=
SMTP_KEY=

# Required in production, where the application refuses to start without the
# first three. The dev profile supplies invented values.
# SITE_URL is the public address that login links point to, such as
# https://teaterihuskvarna.se. MAIL_FROM is the sender on every mail. BANKGIRO
# is the number in the payment instruction a new member gets.
SITE_URL=
MAIL_FROM=
BANKGIRO=
# The first administrator account, created at startup only when none exists.
FIRST_ADMINISTRATOR_EMAIL=
FIRST_ADMINISTRATOR_NAME=

# Database and proxy. The defaults in compose.yaml cover local development, so
# these only need setting in production, together with a generated
# POSTGRES_PASSWORD. SITE_HOST is the host name Traefik routes and gets a
# certificate for, such as teaterihuskvarna.se.
POSTGRES_DB=teaterihuskvarna
POSTGRES_USER=teaterihuskvarna
SITE_HOST=
