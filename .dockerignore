# Only paths that .gitignore also ignores. The Dockerfile explains why a tracked
# file must not be listed here. .env and its variants are here so that
# credentials never enter the build context, and the two tracked examples are
# let back in. .git arrives as its own build context instead: see the
# Dockerfile's git stage.
.env
.env.*
!.env.example
!.env.production.example
.git
target/
**/__pycache__/
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
backups/
visual-editing/node_modules/
visual-editing/dist/
src/main/resources/static/js/visual-editing.js
src/main/resources/static/js/visual-editing.licenses.txt
src/main/resources/static/css/visual-editing.css
